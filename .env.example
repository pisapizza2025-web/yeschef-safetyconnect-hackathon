# All optional. Without these the app runs in labelled rules mode.
# Live AI commentary (xAI / Grok). Needs BOTH a key and a model name.
XAI_API_KEY=
XAI_MODEL=
# XAI_BASE_URL=https://api.x.ai/v1

# Where the event log is stored (needs a writable, persistent disk). Default: ./data
# DATA_DIR=./data

# Where the "find a provider" web search is aimed when a site has no matching supplier.
# Default: the site city from the fixtures.
# SEARCH_NEAR=London W6
